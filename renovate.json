{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "automergeSchedule": [
    "after 5am and before 4pm every weekday",
    "every weekend"
  ],
  "timezone": "Europe/Budapest",
  "packageRules": [
    {
      "matchCategories": [
        "docker"
      ],
      "enabled": true,
      "matchFileNames": [
        "/Dockerfile$/"
      ]
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "matchDepTypes": ["devDependencies"],
      "automerge": true
    },
    {
      "description": "CI updates merge themselves, majors included",
      "matchManagers": ["github-actions"],
      "automerge": true
    }
  ],
  "platformAutomerge": false,
  "ignoreTests": true
}
